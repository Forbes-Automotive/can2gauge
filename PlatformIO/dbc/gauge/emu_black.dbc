BA_DEF_DEF_ "GaugePriority" 0;
BA_DEF_DEF_ "GaugeRelocatable" 0;
BA_DEF_DEF_ "GaugeBusSpeed" 500000;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "GaugeBusSpeed" 1000000;
BA_ "GaugeRelocatable" 1;
BA_ "GaugeKey" SG_ 1536 RPM "rpm";
BA_ "GaugeKey" SG_ 1536 TPS "throttle";
BA_ "GaugeKey" SG_ 1536 IAT "iat";
BA_ "GaugeKey" SG_ 1536 MAP "map";
