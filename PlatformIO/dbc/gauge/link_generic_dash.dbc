CM_ "DRAFT can2gauge DBC: Link G4+/G4X/G5 'Transmit Generic Dash' compound stream. ID, bit rate and rate are set by the tuner (1000 / 1 Mbit / 20 Hz are only the common template values).";
CM_ BO_ 1000 "Source: Link G4+ PCLink help, Generic Dash. G4X/G5 assumed identical (AiM's Generic Dash.lcc channel list matches) - UNVERIFIED on G4X/G5. ID 1000 is the usual template value; the real ID is whatever the tuner set (GaugeRelocatable). Transmit rate user set, 20 Hz typical; whether that is per frame or per full 13-frame cycle is not stated - UNVERIFIED.";
CM_ SG_ 1000 FrameIndex "Compound frame index 0..12 (Link calls them Frame 1..13).";
CM_ SG_ 1000 FrameByte1 "Always 0 per the table. Fingerprint: byte 0 cycles 0..12 and byte 1 stays 0.";
CM_ SG_ 1000 MAP "Absolute kPa (gauge 'map' is mbar: x10).";
CM_ SG_ 1000 MGP "Gauge pressure = raw - 100 kPa.";
CM_ SG_ 1000 GearPosition "Range 0-6. Reverse encoding not documented - UNVERIFIED.";
CM_ SG_ 1000 CamExhaustPositionL "Display = raw x -0.1.";
CM_ SG_ 1000 FuelPressure "kPa (gauge is bar: /100). Gauge or absolute not stated - UNVERIFIED.";
CM_ SG_ 1000 OilPressure "kPa (gauge is bar: /100). Gauge or absolute not stated - UNVERIFIED.";
CM_ SG_ 1000 Limit_RPMLimit "Limits Flags word (bytes 6-7, low byte first); bit 0 taken as the word's least significant bit - UNVERIFIED.";
BA_DEF_ SG_ "GaugeKey" STRING ;
BA_DEF_ SG_ "GaugePriority" INT 0 9;
BA_DEF_ "GaugeRelocatable" INT 0 1;
BA_DEF_ "GaugeBusSpeed" INT 0 1000000;
BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
BA_DEF_DEF_ "GaugeKey" "";
BA_DEF_DEF_ "GaugePriority" 0;
BA_DEF_DEF_ "GaugeRelocatable" 0;
BA_DEF_DEF_ "GaugeBusSpeed" 500000;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "GaugeBusSpeed" 1000000;
BA_ "GaugeRelocatable" 1;
BA_ "GenMsgCycleTime" BO_ 1000 50;
BA_ "GaugeKey" SG_ 1000 EngineSpeed "rpm";
BA_ "GaugeKey" SG_ 1000 MAP "map";
BA_ "GaugeKey" SG_ 1000 TPS "throttle";
BA_ "GaugeKey" SG_ 1000 InjectorDC "injDuty";
BA_ "GaugeKey" SG_ 1000 ECT "coolant";
BA_ "GaugeKey" SG_ 1000 IAT "iat";
BA_ "GaugeKey" SG_ 1000 ECUVolts "batt";
BA_ "GaugeKey" SG_ 1000 MAF "maf";
BA_ "GaugeKey" SG_ 1000 GearPosition "gear";
BA_ "GaugeKey" SG_ 1000 IgnitionTiming "timing";
BA_ "GaugeKey" SG_ 1000 Lambda1 "lambda";
BA_ "GaugeKey" SG_ 1000 FuelPressure "fuelPressure";
BA_ "GaugeKey" SG_ 1000 OilTemp "oiltemp";
BA_ "GaugeKey" SG_ 1000 OilPressure "oilPressure";
VAL_ 1000 GearPosition 0 "N" ;
