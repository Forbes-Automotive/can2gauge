BA_ "GaugeKey" SG_ 1538 OilTemp "oiltemp";
BA_ "GaugeKey" SG_ 1538 OilPressure "oilPressure";
BA_ "GaugeKey" SG_ 1538 FuelPressure "fuelPressure";
BA_ "GaugeKey" SG_ 1538 CLT "coolant";
BA_ "GaugeKey" SG_ 1539 IgnitionAngle "timing";
BA_ "GaugeKey" SG_ 1539 Lambda "lambda";
BA_ "GaugeKey" SG_ 1539 EGT1 "egt";
BA_ "GaugePriority" SG_ 1539 EGT1 2;
BA_ "GaugeKey" SG_ 1539 EGT2 "egt";
BA_ "GaugePriority" SG_ 1539 EGT2 1;
BA_ "GaugeKey" SG_ 1540 Gear "gear";
BA_ "GaugeKey" SG_ 1540 BatteryVoltage "batt";
BA_ "GaugeKey" SG_ 1540 EthanolContent "ethanol";
BA_ "GaugeKey" SG_ 1543 DSGMode "selector";
BA_ "GaugeKey" SG_ 1543 LambdaTarget "lambdaTarget";
VAL_ 1540 Gear 0 "N" ;
VAL_ 1543 DSGMode 2 "P" 3 "R" 4 "N" 5 "D" 6 "S" 7 "M" 15 "Fault" ;
