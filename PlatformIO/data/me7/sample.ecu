[Communication]
Connect      = SLOW-0x11    ; Possible values: SLOW-0x11, FAST-0x10
Communicate  = HM0          ; Possible values: HM0, HM2-0x10
LogSpeed     = 56000        ; Possible values: 10400, 14400, 19200, 38400, 56000, 57600, 125000
[Identification]
HWNumber          = {0261206794}
SWNumber          = {1037360314}
PartNumber        = {8N0906018J  }
SWVersion         = {0004}
EngineId          = {1.8L R4/5VT     }

[Measurements]
