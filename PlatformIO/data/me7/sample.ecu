;   S -> 0 = unsigned, 1 = signed value
;   I -> 0 = normal, 1 = inverse conversion
;   A -> factor
;   B -> offset
; Normal conversion:  phys = A * internal - B
; Inverse conversion: phys = A / (internal - B)
